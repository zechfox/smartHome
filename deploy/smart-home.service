[Unit]
Description=smartHome - lightweight home automation controller
Documentation=file:///opt/smart-home/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/smart-home
Environment=SMART_HOME_CONFIG=/opt/smart-home/config.yaml
ExecStart=/opt/smart-home/.venv/bin/python -m app
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
